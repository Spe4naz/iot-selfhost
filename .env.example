# IoT Modular System — self-hosted deployment settings.
# Copy to .env and adjust. Values in this file map to docker-compose envs.
# Never commit the real .env.

# --- Обязательные -----------------------------------------------------------

# DNS-имя (FQDN), указывающее A-записью на этот сервер.
# Используется nginx (server_name) и certbot (ACME).
NGINX_DOMAIN=iot.example.com

# Токен записи для API:
# обязателен для /api/v1/devices/register, удаления устройств и т.д.
# Его же вводят в приложении в поле «Токен записи (API)».
REGISTER_TOKEN=change-me-register-token

# --- MQTT -------------------------------------------------------------------
# Учётка приложения (вводится в приложении: MQTT Логин / MQTT Пароль).
MQTT_USER=app
MQTT_PASSWORD=change-me-mqtt-app

# Общая учётка устройств (прошивается в конфиг устройства:
# mqtt_user / mqtt_password в config.h).
MQTT_DEVICE_USER=device
MQTT_DEVICE_PASSWORD=change-me-mqtt-device

# --- TLS / Let's Encrypt ----------------------------------------------------
# 0 — только HTTP (LAN/быстрый старт); 1 — HTTPS + автоматический сертификат.
NGINX_TLS=0

# Email для уведомлений Let's Encrypt (обязателен для NGINX_TLS=1).
CERTBOT_EMAIL=

# --- Тюнинг сервера (опционально) ------------------------------------------
PORT=3100
STALE_MS=180000
MAX_DEVICES_PER_IP=3
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_REGISTER=100
RATE_LIMIT_HEARTBEAT=100
RATE_LIMIT_WRITE=100
RATE_LIMIT_READ=100

# Глубина истории метрик панели (ч); период сэмпла/флаша (мс/сек).
METRICS_HOURS=24
METRICS_INTERVAL_MS=10000
METRICS_FLUSH_SECONDS=120

# --- Веб-панель (/panel) ----------------------------------------------------
# Пароль для входа в панель. Пусто — панель отключена (503).
PANEL_PASSWORD=
PANEL_SESSION_TTL_MS=86400000