# HTTP vhost used while NGINX_TLS=1 but the certificate is not yet issued:
# serves the ACME challenge and redirects everything else to HTTPS.

server {
    listen 80;
    listen [::]:80;
    server_name ${NGINX_DOMAIN};

    location = /healthz {
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}